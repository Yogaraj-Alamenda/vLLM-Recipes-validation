# KVShrink validation settings (scripts/kvshrink_validate.sh). Sourced after settings.env;
# override any of these in the environment or the GitHub Actions job.

# KVShrink image. A prebuilt image skips the build; otherwise it is built on
# VLLM_IMAGE from an intel-accel-for-llm checkout (KVSHRINK_SRC, or
# KVSHRINK_REPO at KVSHRINK_REF).
KVSHRINK_IMAGE=${KVSHRINK_IMAGE:-}
KVSHRINK_SRC=${KVSHRINK_SRC:-}
KVSHRINK_REPO=${KVSHRINK_REPO:-}
KVSHRINK_REF=${KVSHRINK_REF:-main}
# intree: in-tree QAT driver (VFs on vfio-pci) shared through the host qatmgr.
# Set empty for the out-of-tree QAT package.
IAXL_QATLIB=${IAXL_QATLIB-intree}
QATLIB_VERSION=${QATLIB_VERSION:-}

# Prefix-hit workload, identical in both runs. Prompts are HIT_RATE percent
# shared prefix + random suffix; vllm bench uses a fixed seed, so both runs
# send the same prompts.
KVSHRINK_INPUT_LEN=${KVSHRINK_INPUT_LEN:-8000}
KVSHRINK_HIT_RATE=${KVSHRINK_HIT_RATE:-80}
KVSHRINK_OUTPUT_LEN=${KVSHRINK_OUTPUT_LEN:-128}
KVSHRINK_NUM_PROMPTS=${KVSHRINK_NUM_PROMPTS:-10}
KVSHRINK_NUM_WARMUPS=${KVSHRINK_NUM_WARMUPS:-5}
KVSHRINK_MAX_CONCURRENCY=${KVSHRINK_MAX_CONCURRENCY:-4}
KVSHRINK_BENCH_TIMEOUT_SEC=${KVSHRINK_BENCH_TIMEOUT_SEC:-3600}

# off: vLLM prefix caching disabled in both runs, so baseline recomputes every
# prompt and the KVShrink run reuses prefixes only through KVShrink.
KVSHRINK_PREFIX_CACHING=${KVSHRINK_PREFIX_CACHING:-off}

# Physical cores per rank taken from the vLLM CPU list for IAXL threads.
KVSHRINK_IAXL_CORES=${KVSHRINK_IAXL_CORES:-2}

# KVShrink-run container options and KEY=VALUE IAXL/KVShrink settings
# (see intel-accel-for-llm setvars.sh). QAT through vfio needs the device
# nodes; /run/qat is mounted automatically when the host qatmgr runs.
KVSHRINK_DOCKER_ARGS=${KVSHRINK_DOCKER_ARGS:---privileged -v /dev:/dev --ulimit memlock=-1:-1}
KVSHRINK_ENV_VARS=${KVSHRINK_ENV_VARS:-IAXL_DDR_POOL_SIZE_GB=16 IAXL_CPU_ZIP_ENABLE=0}
